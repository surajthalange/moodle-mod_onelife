{{!
    @template mod_onelife/summary

    The end of a One Life run.

    A run that ended because the pool ran out is reported as such rather than as a
    loss, because the learner got nothing wrong.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * cmid number The course module id
    * streak number The streak reached
    * targetstreak number The streak counting as 100 per cent
    * percent number The streak as a percentage of the target, capped at 100
    * correctanswer string The correct answer's text
    * hascorrectanswer boolean Whether there is a correct answer to show
    * explanation string The explanation, already formatted
    * hasexplanation boolean Whether there is an explanation to show
    * exhausted boolean Whether the run ended because the pool ran out
    * exhaustedmessage string The message explaining that
    * sesskey string The session key

    Example context (json):
    {
        "cmid": 42,
        "streak": 7,
        "targetstreak": 15,
        "percent": 47,
        "correctanswer": "Mitochondrion",
        "hascorrectanswer": true,
        "explanation": "<p>ATP is made in the mitochondrion.</p>",
        "hasexplanation": true,
        "exhausted": false,
        "exhaustedmessage": "",
        "sesskey": "abc123"
    }
}}
<div class="onelife-summary">

    <h3 class="onelife-summary__heading">{{#str}} runover, mod_onelife {{/str}}</h3>

    <p class="onelife-summary__score" role="status">
        {{#str}} finalstreak, mod_onelife, {{streak}} {{/str}}
        <span class="onelife-summary__percent">{{percent}}%</span>
    </p>

    {{#exhausted}}
        <div class="alert alert-info onelife-summary__exhausted" role="alert">{{exhaustedmessage}}</div>
    {{/exhausted}}

    {{^exhausted}}
        {{#hascorrectanswer}}
            <p class="onelife-summary__correct">
                {{#str}} thecorrectanswerwas, mod_onelife {{/str}}
                <strong>{{correctanswer}}</strong>
            </p>
        {{/hascorrectanswer}}
    {{/exhausted}}

    {{#hasexplanation}}
        <div class="onelife-summary__explanation">{{{explanation}}}</div>
    {{/hasexplanation}}

    <p class="onelife-summary__actions">
        <a href="{{{config.wwwroot}}}/mod/onelife/view.php?id={{cmid}}" class="btn btn-primary">
            {{#str}} backtoactivity, mod_onelife {{/str}}
        </a>
    </p>

</div>
